# Notask Flow 后端本地开发环境变量模板(dev profile)。
# 复制为 backend/.env,application-dev.yml 会通过 spring.config.import 自动读取。
# 真实 .env 已被 Git 忽略,请勿提交。

# 配置 profile(默认 dev,一般无需修改)
SPRING_PROFILES_ACTIVE=dev

# MySQL(默认与 deploy/dev/docker-compose.yml 一致)
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/notask_flow?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&allowPublicKeyRetrieval=true&useSSL=true&serverTimezone=Asia/Hong_Kong
MYSQL_USERNAME=notask
MYSQL_PASSWORD=notask

# Redis
REDIS_HOST=127.0.0.1
REDIS_HOST_PORT=6379
REDIS_PASSWORD=notask

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_HOST_PORT=5672
RABBITMQ_USERNAME=notask
RABBITMQ_PASSWORD=notask

# Elasticsearch
ELASTICSEARCH_ENDPOINT=http://127.0.0.1:9200

# MinIO(默认与 deploy/dev 一致,桶由 minio-init 服务自动创建)
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=notask-flow

# Sa-Token JWT 密钥(变更后所有会话失效;本地可用任意随机串)
SA_TOKEN_JWT_SECRET=dev-only-secret-change-me

# 管理后台初始账号
ADMIN_USERNAME=Administrator
ADMIN_PASSWORD=change-me

# 协同服务集成
# 内部鉴权令牌,必须与 collab-ws 的 INTERNAL_TOKEN 保持一致
COLLAB_INTERNAL_TOKEN=notask-flow-collab-internal-change-me
# 空间实时事件推送地址(dev 下 collab-ws 容器映射到宿主机 8081)
COLLAB_REALTIME_BROADCAST_URL=http://localhost:8081/internal/broadcast

# 邮件(本地联调邮箱验证码、找回密码时配置;留空则邮件发送不可用)
# 以 163 邮箱为例:MAIL_PASSWORD 填邮箱的 SMTP 授权码,而非登录密码
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USERNAME=your-email@163.com
MAIL_PASSWORD=
# 发件人展示地址(一般与 MAIL_USERNAME 一致)
NOTASK_MAIL_FROM=your-email@163.com
# 邮件中回跳链接使用的站点地址(找回密码等)
NOTASK_APP_BASE_URL=http://localhost:3000
# SMTP 细化参数(以下默认值一般无需修改)
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_SSL_ENABLE=true
# MAIL_SMTP_STARTTLS_ENABLE=false
# MAIL_SMTP_CONNECTION_TIMEOUT=5000
# MAIL_SMTP_TIMEOUT=5000
# MAIL_SMTP_WRITE_TIMEOUT=5000

# CORS 允许的前端来源(逗号分隔;本地前端 dev 端口为 3000,局域网联调时追加对应地址)
SECURITY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 文件上传高级选项(以下为默认值,一般无需修改)
# 单文件大小上限
FILE_MAX_SIZE=50MB
# 分片大小与分片临时目录(留空使用系统临时目录)
FILE_CHUNK_SIZE=5242880
FILE_MULTIPART_THRESHOLD_SIZE=52428800
FILE_CHUNK_TEMP_DIR=
# 分片上传会话有效期(分钟)
FILE_CHUNK_UPLOAD_SESSION_MINUTES=30
# 回收站保留天数与定时清理(cron 为秒 分 时 日 月 周)
FILE_TRASH_RETENTION_DAYS=30
FILE_CLEANUP_ENABLED=true
FILE_CLEANUP_CRON=0 0 3 * * *
FILE_CLEANUP_BATCH_SIZE=100

# 其他可选配置(以下为默认值)
# Redis 逻辑库编号
REDIS_DATABASE=0
# 同一账号重复登录是否复用已有会话(false=每次登录签发新 token)
SA_TOKEN_IS_SHARE=false
# 团队邀请码默认有效期(分钟)
INVITE_DEFAULT_EXPIRE_MINUTES=30
# Elasticsearch 连接与读取超时
ELASTICSEARCH_CONNECTION_TIMEOUT=3s
ELASTICSEARCH_SOCKET_TIMEOUT=3s
# 安全开关(默认关闭;开启前请确认前端配套支持)
# SECURITY_CSRF_ENABLED=false
# SECURITY_CORS_ALLOW_CREDENTIALS=false
