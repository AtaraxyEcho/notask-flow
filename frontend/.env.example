# Notask Flow frontend environment template.
# Copy to .env.local for local development or to a deployment-specific .env file before building.

# Browser-facing REST API base URL.
# Local Vite development usually keeps this as /api/v1 and lets vite.config.ts proxy /api.
VITE_API_BASE_URL=/api/v1

# Browser-facing WebSocket URL for Yjs document collaboration and space realtime events.
# Local Vite development usually keeps this as /ws and lets vite.config.ts proxy /ws.
VITE_COLLAB_WS_URL=/ws

# Vite dev-server proxy targets. These are only used by npm run dev.
VITE_DEV_API_PROXY_TARGET=http://localhost:8080
VITE_DEV_COLLAB_WS_PROXY_TARGET=http://localhost:8081
