# ===========================================
# 生产环境配置
# ===========================================

# ⚠️ 警告：部署前必须修改所有默认值！

# Spring 配置
SPRING_PROFILES_ACTIVE=docker

# 管理员账号（必须修改）
ADMIN_USERNAME=Administrator
ADMIN_PASSWORD=change-me-admin-password

# 基础设施端口
APP_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
COLLAB_WS_HOST_PORT=8081
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
ELASTICSEARCH_HOST_PORT=9200

# 数据库（必须修改密码）
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=notask_flow
MYSQL_USERNAME=notask
MYSQL_PASSWORD=change-me-db-password

# Redis（必须修改密码）
REDIS_PASSWORD=change-me-redis-password

# RabbitMQ（必须修改密码）
RABBITMQ_USERNAME=notask
RABBITMQ_PASSWORD=change-me-rabbitmq-password

# MinIO（必须修改密钥）
MINIO_ACCESS_KEY=change-me-minio-access-key
MINIO_SECRET_KEY=change-me-minio-secret-key
MINIO_BUCKET=notask-flow

# Elasticsearch
ES_JAVA_OPTS=-Xms1g -Xmx1g
ELASTICSEARCH_ENABLED=true

# JWT（必须修改为强随机字符串）
SA_TOKEN_JWT_SECRET=change-me-to-a-long-random-jwt-secret

# 协作服务（必须修改为强随机字符串）
COLLAB_INTERNAL_TOKEN=change-me-to-a-long-random-internal-token
COLLAB_API_BASE_URL=http://app:8080
COLLAB_REALTIME_BROADCAST_URL=http://collab-ws:8081/internal/broadcast
# 协作服务调试日志（默认关闭，排障时开启）
COLLAB_DEBUG_LOGS=false

# 前端构建参数（构建镜像时注入 VITE_ 变量；经反向代理同域部署时保持默认，
# 前后端分域名部署时改为完整地址，如 https://api.your-domain.com/v1 与 wss://your-domain.com/ws）
FRONTEND_API_BASE_URL=/api/v1
FRONTEND_COLLAB_WS_URL=/ws

# CORS（按实际域名配置）
SECURITY_ALLOWED_ORIGINS=https://your-domain.com
# 安全开关（以下为默认值；开启前请确认前端配套支持）
# SECURITY_CSRF_ENABLED=false
# SECURITY_CORS_ALLOW_CREDENTIALS=false

# 邮件（可选，不配置则邮箱验证码与找回密码不可用）
NOTASK_MAIL_FROM=no-reply@your-domain.com
NOTASK_APP_BASE_URL=https://your-domain.com
MAIL_HOST=smtp.your-mail-provider.com
MAIL_PORT=465
MAIL_USERNAME=your-email@your-domain.com
MAIL_PASSWORD=change-me-mail-password
# SMTP 细化参数（以下为默认值，一般无需修改）
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_SSL_ENABLE=true
# MAIL_SMTP_STARTTLS_ENABLE=false
# MAIL_SMTP_CONNECTION_TIMEOUT=5000
# MAIL_SMTP_TIMEOUT=5000
# MAIL_SMTP_WRITE_TIMEOUT=5000

# 可选高级配置（以下为默认值，一般无需修改）
# Redis 逻辑库编号
# REDIS_DATABASE=0
# 同一账号重复登录是否复用已有会话（false=每次登录签发新 token）
# SA_TOKEN_IS_SHARE=false
# 团队邀请码默认有效期（分钟）
# INVITE_DEFAULT_EXPIRE_MINUTES=30
# 文件上传与清理
# FILE_MAX_SIZE=50MB
# FILE_CHUNK_SIZE=5242880
# FILE_MULTIPART_THRESHOLD_SIZE=52428800
# FILE_CHUNK_TEMP_DIR=
# FILE_CHUNK_UPLOAD_SESSION_MINUTES=30
# FILE_TRASH_RETENTION_DAYS=30
# FILE_CLEANUP_ENABLED=true
# FILE_CLEANUP_CRON=0 0 3 * * *
# FILE_CLEANUP_BATCH_SIZE=100
# Elasticsearch 连接与读取超时
# ELASTICSEARCH_CONNECTION_TIMEOUT=3s
# ELASTICSEARCH_SOCKET_TIMEOUT=3s

# 时区
TZ=Asia/Hong_Kong
